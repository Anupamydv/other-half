{
  "name": "other-half",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev --workspace=@other-half/api\" \"npm:dev --workspace=@other-half/web\"",
    "dev:api": "npm run dev --workspace=@other-half/api",
    "dev:web": "npm run dev --workspace=@other-half/web",
    "db:up": "docker compose -f infra/compose.yaml up -d db",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "npm run db:generate --workspace=@other-half/api",
    "db:migrate": "npm run db:migrate --workspace=@other-half/api",
    "db:deploy": "prisma migrate deploy --config=prisma.config.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3"
  }
}
