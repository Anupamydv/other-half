generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isModerator  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile?
  sessions     Session[]
  listings     Listing[]
  savedListings SavedListing[]
  tourRequests TourRequest[] @relation("TourRequester")
  ownedConversations Conversation[] @relation("ConversationOwner")
  guestConversations Conversation[] @relation("ConversationGuest")
  sentMessages ConversationMessage[]
  blocksGiven UserBlock[] @relation("UserBlocksGiven")
  blocksReceived UserBlock[] @relation("UserBlocksReceived")
  notifications Notification[]
  discoveryActionsMade DiscoveryAction[] @relation("DiscoveryActionActor")
  discoveryActionsReceived DiscoveryAction[] @relation("DiscoveryActionTarget")
  lowMatches Match[] @relation("MatchLowUser")
  highMatches Match[] @relation("MatchHighUser")
  reportsSubmitted UserReport[] @relation("ReportAuthor")
  reportsReceived UserReport[] @relation("ReportSubject")
  reportsReviewed UserReport[] @relation("ReportReviewer")
  mediaUploads ListingMedia[]

  @@index([createdAt])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  age          Int?
  role         String?
  city         City     @default(BENGALURU)
  neighborhood String?
  bio          String   @default("") @db.VarChar(500)
  preferences  Json?
  discoveryEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Listing {
  id             String          @id @default(cuid())
  ownerId        String
  title          String          @db.VarChar(120)
  description    String          @db.VarChar(2000)
  city           City
  neighborhood   String          @db.VarChar(100)
  listingType    ListingType
  monthlyRent    Int
  deposit        Int?
  availableFrom  DateTime        @db.Date
  minimumStay    Int             @default(6)
  amenities      ListingAmenity[] @default([])
  approximateLatitude Float?
  approximateLongitude Float?
  status         ListingStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  savedBy        SavedListing[]
  tourRequests   TourRequest[]
  conversations  Conversation[]
  media          ListingMedia[]

  @@index([status, city, neighborhood, monthlyRent])
  @@index([status, city, neighborhood, availableFrom])
  @@index([amenities], type: Gin)
  @@index([ownerId, status, createdAt])
  @@index([createdAt])
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt])
}

model ListingMedia {
  id          String          @id @default(cuid())
  listingId   String
  uploaderId  String
  objectKey   String          @unique
  contentType String          @db.VarChar(100)
  byteSize    Int
  altText     String          @default("") @db.VarChar(200)
  sortOrder   Int             @default(0)
  status      ListingMediaStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  verifiedAt  DateTime?
  expiresAt   DateTime        @default(now())
  listing     Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploader    User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([listingId, status, sortOrder, createdAt])
  @@index([uploaderId, createdAt])
}

model TourRequest {
  id                String            @id @default(cuid())
  listingId         String
  requesterId       String
  scheduledDate     DateTime          @db.Date
  timeSlot          TourTimeSlot
  note              String            @default("") @db.VarChar(500)
  status            TourRequestStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester         User              @relation("TourRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  notifications     Notification[]

  @@index([listingId, status, scheduledDate])
  @@index([requesterId, status, createdAt])
}

model Conversation {
  id             String                @id @default(cuid())
  listingId      String?
  matchId        String?               @unique
  ownerId        String
  guestId        String
  ownerReadAt    DateTime?
  guestReadAt    DateTime?
  lastMessageAt  DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  listing        Listing?              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  match          Match?                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  owner          User                  @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guest          User                  @relation("ConversationGuest", fields: [guestId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]

  @@unique([listingId, ownerId, guestId])
  @@index([ownerId, lastMessageAt])
  @@index([guestId, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  tourRequestId String
  type          NotificationType
  title         String           @db.VarChar(120)
  body          String           @db.VarChar(300)
  createdAt     DateTime         @default(now())
  readAt        DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourRequest   TourRequest      @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([tourRequestId])
}

model DiscoveryAction {
  id         String               @id @default(cuid())
  actorId    String
  targetId   String
  action     DiscoveryActionType
  createdAt  DateTime             @default(now())
  actor      User                 @relation("DiscoveryActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  target     User                 @relation("DiscoveryActionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId])
  @@index([actorId, createdAt])
  @@index([targetId, action])
}

model Match {
  id         String   @id @default(cuid())
  lowUserId  String
  highUserId String
  createdAt  DateTime @default(now())
  lowUser    User     @relation("MatchLowUser", fields: [lowUserId], references: [id], onDelete: Cascade)
  highUser   User     @relation("MatchHighUser", fields: [highUserId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([lowUserId, highUserId])
  @@index([lowUserId, createdAt])
  @@index([highUserId, createdAt])
}

model UserReport {
  id             String           @id @default(cuid())
  reporterId     String
  reportedUserId String
  reviewerId     String?
  reason         UserReportReason
  details        String           @default("") @db.VarChar(1000)
  status         UserReportStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reviewedAt     DateTime?
  reporter       User             @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User             @relation("ReportSubject", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewer       User?            @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, status, createdAt])
  @@index([reporterId, createdAt])
}

enum City {
  BENGALURU
  MUMBAI
  DELHI_NCR
  HYDERABAD
}

enum ListingType {
  PRIVATE_ROOM
  SHARED_ROOM
  ENTIRE_FLAT
}

enum ListingAmenity {
  FURNISHED
  WIFI
  AIR_CONDITIONING
  LAUNDRY
  PARKING
  PET_FRIENDLY
  VEGETARIAN_HOUSEHOLD
}

enum ListingStatus {
  ACTIVE
  ARCHIVED
}

enum TourRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum TourTimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum NotificationType {
  TOUR_REQUESTED
  TOUR_CONFIRMED
  TOUR_DECLINED
  TOUR_CANCELLED
}

enum DiscoveryActionType {
  PASS
  LIKE
  SUPER_LIKE
}

enum UserReportReason {
  HARASSMENT
  SCAM
  INAPPROPRIATE
  FAKE_PROFILE
  OTHER
}

enum UserReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ListingMediaStatus {
  PENDING
  READY
}
