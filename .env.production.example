# Copy to .env.production and replace every placeholder. Never commit real secrets.
IMAGE_TAG=local
WEB_PORT=8080
WEB_ORIGIN=https://other-half.example.com
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/otherhalf?sslmode=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
VITE_GOOGLE_MAPS_API_KEY=
MEDIA_S3_ENDPOINT=https://S3_INTERNAL_ENDPOINT
MEDIA_S3_PUBLIC_ENDPOINT=https://S3_PUBLIC_ENDPOINT
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
MEDIA_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
MEDIA_S3_BUCKET=other-half-media
